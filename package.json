{
  "name": "all-agents-in-one",
  "productName": "All Agents in One",
  "version": "0.2.3",
  "private": true,
  "description": "A project-oriented terminal workspace for CLI agents.",
  "author": "changsu",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac dmg",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.allagentsinone.terminal",
    "productName": "All Agents in One",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.svg.png",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
